        "jsCode": "\nreturn {\n  json: {\n    job_id: $json[\"Job ID\"] ?? $json.job_id ?? \"\",\n    job_title: $json[\"Job Title\"] ?? $json.job_title ?? \"\",\n    company: $json[\"Company\"] ?? $json.company ?? \"\",\n    location: $json[\"Location\"] ?? $json.location ?? \"\",\n    job_type: $json[\"Job Type\"] ?? $json.job_type ?? \"\",\n    experience_level: $json[\"Experience Level\"] ?? $json.experience_level ?? \"\",\n    required_skills: $json[\"Required Skills\"] ?? $json.required_skills ?? \"\",\n    job_description: $json[\"Job Description\"] ?? $json.job_description ?? \"\",\n    application_url: $json[\"Application URL\"] ?? $json.application_url ?? \"\",\n    source: $json[\"Source\"] ?? $json.source ?? \"\",\n    posted_date: $json[\"Posted Date\"] ?? $json.posted_date ?? \"\",\n    date_found: $json[\"Date Found\"] ?? $json.date_found ?? \"\",\n    status: $json[\"Status\"] ?? $json.status ?? \"New\"\n  }\n};\n"
