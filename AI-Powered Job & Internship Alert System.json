    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst response = $json.text ?? \"\";\n\nconst cleaned = response\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    \"Gemini did not return valid JSON. Response: \" + response\n  );\n}\n\nconst score = Number(parsed.match_score);\nconst reason = String(parsed.match_reason ?? \"\").trim();\n\nif (!Number.isInteger(score) || score < 0 || score > 100) {\n  throw new Error(\"Gemini returned an invalid match score.\");\n}\n\nreturn {\n  json: {\n    match_score: score,\n    match_reason: reason\n  }\n};\n"
      },
