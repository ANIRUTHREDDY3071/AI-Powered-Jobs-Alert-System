      "id": "95937857-4dff-45f6-a10d-71a51aa2062b",
      "name": "Normalize Job Listings",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst seen = new Set();\nconst uniqueJobs = [];\n\nfor (const item of items) {\n  const job = item.json;\n\n  // Prefer the API's unique job ID.\n  // Use a fallback key when an ID is unavailable.\n  const key = job.job_id\n    ? String(job.job_id).trim()\n    : [\n        job.job_title,\n        job.company,\n        job.location,\n        job.application_url\n      ]\n        .map(value => String(value ?? \"\").trim().toLowerCase())\n        .join(\"|\");\n\n  if (!key.replace(/\\|/g, \"\")) {\n    continue;\n  }\n\n  if (seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n  uniqueJobs.push({ json: job });\n}\n\nreturn uniqueJobs;\n"
      },
