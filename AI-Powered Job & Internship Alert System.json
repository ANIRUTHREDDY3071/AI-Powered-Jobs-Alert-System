    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const response = item.json;\n\n  // Your JSearch response contains jobs inside data.jobs.\n  const jobs = response.data?.jobs ?? [];\n\n  if (!Array.isArray(jobs)) {\n    continue;\n  }\n\n  for (const job of jobs) {\n    if (!job.job_title || !job.employer_name) {\n      continue;\n    }\n\n    results.push({\n      json: {\n        job_id: job.job_id ?? \"\",\n        job_title: job.job_title,\n        company: job.employer_name,\n        location: [\n          job.job_city,\n          job.job_state,\n          job.job_country\n        ].filter(Boolean).join(\", \"),\n        job_type: job.job_employment_type ?? \"\",\n        experience_level:\n          job.job_required_experience\n            ?.required_experience_in_months ?? null,\n        required_skills: \"\",\n        job_description: job.job_description ?? \"\",\n        application_url:\n          job.job_apply_link ?? job.job_google_link ?? \"\",\n        source: \"JSearch\",\n        posted_date: job.job_posted_at_datetime_utc ?? \"\",\n        date_found: new Date().toISOString(),\n        status: \"New\"\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
