    {
      "parameters": {
        "jsCode": "\nconst newItems = $(\"Remove Duplicate Jobs\").all();\nconst existingItems = $(\"Read Existing Job IDs\").all();\n\nfunction normalize(value) {\n  return String(value ?? \"\")\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \" \")\n    .trim()\n    .replace(/\\s+/g, \" \");\n}\n\nfunction getValue(job, ...fields) {\n  for (const field of fields) {\n    if (job[field] !== undefined &&\n        job[field] !== null &&\n        String(job[field]).trim() !== \"\") {\n      return job[field];\n    }\n  }\n  return \"\";\n}\n\nfunction makeTitleKey(job, titleField, companyField, locationField) {\n  const title = normalize(getValue(job, titleField));\n  const company = normalize(getValue(job, companyField));\n  const location = normalize(getValue(job, locationField));\n\n  if (!title || !company) return \"\";\n  return `${title}|${company}|${location}`;\n}\n\nfunction makeUrlKey(job, urlField) {\n  const raw = String(getValue(job, urlField)).trim();\n  if (!raw) return \"\";\n\n  try {\n    const url = new URL(raw);\n    return (url.hostname + url.pathname)\n      .toLowerCase()\n      .replace(/\\/+$/, \"\");\n  } catch {\n    return normalize(raw);\n  }\n}\n\nconst existingKeys = new Set();\nconst existingUrls = new Set();\n\nfor (const item of existingItems) {\n  const row = item.json;\n  const key = makeTitleKey(\n    row, \"Job Title\", \"Company\", \"Location\"\n  );\n  const url = makeUrlKey(row, \"Application URL\");\n\n  if (key) existingKeys.add(key);\n  if (url) existingUrls.add(url);\n}\n\nconst seenKeys = new Set();\nconst seenUrls = new Set();\nconst results = [];\n\nfor (const item of newItems) {\n  const job = item.json;\n  const key = makeTitleKey(\n    job, \"job_title\", \"company\", \"location\"\n  );\n  const url = makeUrlKey(job, \"application_url\");\n\n  if (!key) continue;\n  if (normalize(job.job_title).includes(\"junior data scientist\")) {\n  console.log(\"Incoming job:\", {\n    title: job.job_title,\n    company: job.company,\n    location: job.location,\n    key\n  });\n  console.log(\"Existing keys:\", [...existingKeys]);\n}\n  if (existingKeys.has(key)) continue;\n  if (url && existingUrls.has(url)) continue;\n  if (seenKeys.has(key)) continue;\n  if (url && seenUrls.has(url)) continue;\n\n  seenKeys.add(key);\n  if (url) seenUrls.add(url);\n\n  results.push({ json: job });\n}\n\nreturn results;\n"
      },
